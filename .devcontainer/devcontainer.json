{
  "name": "AutoAhorro Monorepo DevEnv",
  
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js Frontend",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "FastAPI Compute Engine",
      "onAutoForward": "notify"
    }
  },
  //arch linux
  "remoteUser": "vscode",

  "postCreateCommand": "cd apps/web && npm install && npx prisma generate && cd ../compute && rm -rf venv && python3 -m venv venv && ./venv/bin/pip install --upgrade pip && ./venv/bin/pip install -r requirements.txt",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/auto-ahorro/apps/compute/venv/bin/python",
        "typescript.tsdk": "apps/web/node_modules/typescript/lib"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens"
      ]
    }
  }
}